# Copy to .env and adjust. Never commit .env.

ENV=local
LOG_LEVEL=INFO

# Ports 5433/6380 — this machine already runs an unrelated Postgres/Redis stack on 5432/6379.
DATABASE_URL=postgresql+asyncpg://ii:ii@localhost:5433/investment_intelligence
REDIS_URL=redis://localhost:6380/0

# MVP mono-user auth (architecture v1.0, decision #12)
API_KEY=dev-local-key

# Not used until Phase 1+ agents are implemented — safe to leave blank for Phase 0.
ANTHROPIC_API_KEY=

# Frozen weights set to load (config/weights/v1.0.yaml). See architecture v1.0, decision #9.
WEIGHTS_VERSION=v1.0

# SEC EDGAR requires a descriptive User-Agent (name + contact email) per its fair-access policy —
# not a secret. https://www.sec.gov/os/webmaster-faq#developers
SEC_EDGAR_USER_AGENT="your-app-name your-email@example.com"

# Massive (formerly Polygon.io) API key — a real secret. Leave blank to run everything except the
# one opt-in live test in tests/unit/test_massive_provider.py (skipped automatically without it).
MASSIVE_API_KEY=
